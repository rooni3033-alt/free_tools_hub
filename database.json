#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
One-Time Fix: Remove fake tools and regenerate them as real functional apps
Run: python fix_old_tools.py
"""

import json
import os
import shutil
from pathlib import Path

TOOLS_DIR = Path("./tools")
DB_FILE = Path("./database.json")

def is_fake_tool(html_content):
    """Detect if a tool HTML is fake/placeholder (no real JS functionality)"""
    html_lower = html_content.lower()
    
    # Signs of a fake tool:
    # 1. No <script> tag at all
    has_script = '<script>' in html_lower or '<script ' in html_lower
    
    # 2. Contains placeholder text
    has_placeholder = any(x in html_lower for x in [
        'coming soon', 'placeholder', 'under construction', 
        'قريباً', 'قريبا', 'قيد الإنشاء', 'وهمية', 'fake'
    ])
    
    # 3. No input, textarea, or button elements (can't be interactive)
    has_interactive = any(x in html_lower for x in ['<input', '<textarea', '<button', '<select'])
    
    # If it has no script AND no interactive elements = 100% fake
    # If it has placeholder text = fake
    if has_placeholder:
        return True
    if not has_script and not has_interactive:
        return True
    if not has_script:
        return True  # A real tool MUST have JS logic
    
    return False

def main():
    print("🔍 Scanning for fake/old tools...")
    
    if not DB_FILE.exists():
        print("❌ database.json not found!")
        return
    
    with open(DB_FILE, "r", encoding="utf-8") as f:
        db = json.load(f)
    
    tools = db.get("tools", [])
    original_count = len(tools)
    
    real_tools = []
    removed_count = 0
    
    for tool in tools:
        slug = tool.get("slug", "")
        html_path = TOOLS_DIR / f"{slug}.html"
        
        if not html_path.exists():
            print(f"⚠️  Missing file: {slug}.html — removing from DB")
            removed_count += 1
            continue
        
        with open(html_path, "r", encoding="utf-8") as f:
            content = f.read()
        
        if is_fake_tool(content):
            print(f"🗑️  Removing fake tool: {tool.get('name', slug)}")
            # Delete the fake HTML file
            html_path.unlink(missing_ok=True)
            removed_count += 1
        else:
            real_tools.append(tool)
    
    # Update database
    db["tools"] = real_tools
    
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(db, f, ensure_ascii=False, indent=2)
    
    print(f"\n✅ Cleanup complete!")
    print(f"   Original tools: {original_count}")
    print(f"   Real tools kept: {len(real_tools)}")
    print(f"   Fake tools removed: {removed_count}")
    print(f"\n🚀 Next step: Run 'python main.py' to generate {removed_count} new REAL tools!")

if __name__ == "__main__":
    main()
